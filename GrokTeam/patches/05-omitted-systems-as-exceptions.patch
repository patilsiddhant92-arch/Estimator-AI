+def omitted_exception_text(system: System, reason: str | None = None) -> str:
+    """The named exception of a system the job names but AME does no work on, in the estimator's form (rules.md
+    "Named exceptions"): "EXCEPTION TO ANY WORK WITH Qty (n) <tags> - <reason>". The count is the families' printed
+    counts added up ("Qty (##)" when one is unknown); the tags as written, else the system's name; the reason the
+    given words (the writer's no_scope_reason or the source's), upper case, left off when there are none: no
+    reason wording of its own (R15 is pending)."""
+    counts = [f.count.highest() for f in system.families]
+    n = "Qty (##)" if not counts or any(c is None for c in counts) else f"Qty ({sum(counts)})"
+    tags = [t.strip() for f in system.families for t in f.tags if t.strip()]
+    text = EXCEPTION_FORM.format(n=n, tags=", ".join(dict.fromkeys(tags)) or system.name.upper())
+    reason = _squash(reason or "").rstrip(" .;")
+    return f"{text} - {reason.upper()}" if reason else text
 
 

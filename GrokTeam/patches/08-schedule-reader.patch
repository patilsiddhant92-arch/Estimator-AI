@@ -125,6 +125,24 @@ def _is(header: str, words: Iterable[str]) -> bool:
     return any(key == w or key.startswith(w + " ") for w in words)
 
 
+def _is_remarks(header: str, vocab: Vocabulary) -> bool:
+    """A remarks column: a notes header word anywhere in it ("CONTROLS BY / NOTES", "UNIT REMARKS"), or a column
+    that says who controls or furnishes the unit ("CONTROLS BY", "FURNISHED BY")."""
+    key = header_key(header)
+    return (any(re.search(rf"\b{re.escape(w)}\b", key) for w in vocab.notes_headers)
+            or bool(re.search(r"\bCONTROLS?\s+BY\b|\bFURNISHED\s+BY\b", key)))
+
+
+# a drawing's revision block (MARK | DATE | DESCRIPTION): ruled like a schedule, keyed by MARK, never equipment
+_REVISION_HEADERS = re.compile(r"^(?:DATE|DESCRIPTION|REVISION|REV|ISSUE|BY|APP'?D|CHK'?D)$")
+
+
+def _revision_block(schedule: "Schedule") -> bool:
+    keys = [header_key(h) for h in schedule.headers]
+    return (schedule.type_only and len(keys) >= 2 and "DATE" in keys
+            and all(_REVISION_HEADERS.match(k) for k in keys[1:]))
+
+

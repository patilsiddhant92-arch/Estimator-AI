 _ID_LINE = re.compile(r"^\[(S\d+)\] (.*)$")
@@ -92,6 +93,97 @@ def _positive(value) -> int | None:
     return n if n > 0 else None
 
 
+# section 4, one schedule: "[S5] AIR UNIT SCHEDULE — M-601, Mech.pdf page 1 (3 rows)", "    Columns: TAG | QTY | ...",
+# then a "[S6] AHU-1 | 1 | ..." line per row and "[S9] Note: 1. ..." per note (`dossier._schedules_section`)
+_SCHEDULE_LINE = re.compile(r"^\[(S\d+)\] .+ — .+ \(\d+ rows?[;)]")
+_COLUMNS_LINE = re.compile(r"^\s+Columns: (.*)$")
+_ROW_TAG = re.compile(r"^[A-Z][A-Z0-9]{0,5}-[A-Z0-9][A-Z0-9.\-]*$")
+_EXISTING_MARK = " (EXISTING)"
+_AREA_HEADER = re.compile(r"\b(?:AREAS?|ROOMS?|SPACES?)\s+SERVED\b|^SERV(?:ES|ING|ED)\b|^(?:ROOM|AREA|SPACE|LOCATION)\b")
+_OWNER_HEADER = re.compile(r"\bCONTROLS?\b|\bFURNISHED\s+BY\b|\b(?:REMARKS?|NOTES?|COMMENTS)\b")
+_SEE_NOTE = re.compile(r"\bSEE\s+NOTES?\s+#?(\d+)\b", re.I)
+# a cell that says who furnishes or controls: "DDC BY UNIT MFR", "SENSOR FURNISHED BY UNIT MFR", "CONTROLS BY OTHERS"
+_OWNER_WORDS = re.compile(
+    r"\b(?:furnished|provided|supplied|installed|wired|mounted)\s+(?:by|with)\b|"
+    r"\bby\s+(?:the\s+)?(?:unit|equipment|others|mfr|manufacturer|owner|mech\w*|elec\w*|controls?|tcc|atc|div)", re.I)
+
+
+def _number(text: str) -> int | None:
+    match = re.fullmatch(r"\(?(\d{1,4})\)?", text.strip())
+    return int(match.group(1)) if match and int(match.group(1)) > 0 else None
+
+
+def schedule_row_facts(ledger: Ledger, section: str) -> None:
+    """One fact per scheduled unit tag from its schedule row in the dossier's section 4, citing the row's own line:
+    `schedule_qty` (the QTY column), `maker` (the manufacturer column), `area_served` (AREA SERVED, SERVES, ROOM ...)
+    and a `provider` fact for the unit's controls / furnished-by owner (a CONTROLS BY or REMARKS / NOTES cell that
+    names a party, or the schedule note a "SEE NOTE n" cell points to). Only what a column states: no column, no
+    fact. Rows without a unit tag (types, revision rows) give none."""
+    vocab = vocabulary()
+    headers: list[str] = []
+    rows: list[tuple[str, list[str], str]] = []
+    notes: dict[str, tuple[str, str]] = {}
+
+    def flush() -> None:
+        if not headers or not rows:
+            return
+        keys = [header_key(h) for h in headers]
+        qty = next((i for i, k in enumerate(keys) if k in vocab.quantity_headers), None)
+        maker = next((i for i, k in enumerate(keys)
+                      if any(k == w or k.startswith(w + " ") for w in vocab.manufacturer_headers)), None)
+        area = next((i for i, k in enumerate(keys) if i and _AREA_HEADER.search(k)), None)
+        owners = [i for i, k in enumerate(keys) if i and _OWNER_HEADER.search(k)]
+        for sid, cells, quote in rows:
+            tag = cells[0].removesuffix(_EXISTING_MARK).strip()
+            if not _ROW_TAG.match(tag):
+                continue
+            value = lambda i: cells[i].strip() if i is not None and cells[i].strip() not in ("", "-") else ""  # noqa: E731
+            if qty is not None and _number(value(qty) or "") is not None:
+                ledger.add("schedule_qty", tag, _number(value(qty)), sid, quote, "seed", SETTLED)
+            if value(maker):
+                ledger.add("maker", tag, value(maker), sid, quote, "seed", SETTLED)
+            if value(area):
+                ledger.add("area_served", tag, value(area), sid, quote, "seed", SETTLED)
+            for i in owners:
+                cell = value(i)
+                pointed = _SEE_NOTE.search(cell)
+                if pointed and pointed.group(1) in notes:
+                    nid, text = notes[pointed.group(1)]
+                    if _OWNER_WORDS.search(text) or vocab.controls.search(text):
+                        ledger.add("provider", tag, text, nid, text, "seed", ADDED)
+                elif cell and (_OWNER_WORDS.search(cell) or vocab.controls.search(cell)):
+                    ledger.add("provider", tag, cell, sid, quote, "seed", ADDED)
+
+    lines = section.splitlines()
+    for n, line in enumerate(lines):
+        if _SCHEDULE_LINE.match(line):
+            flush()
+            headers, rows, notes = [], [], {}
+            # the schedule's notes, wherever they sit after its rows, so a "SEE NOTE n" row can be read first
+            for later in lines[n + 1:]:
+                if _SCHEDULE_LINE.match(later):
+                    break
+                found = _ID_LINE.match(later)
+                if found and found.group(2).startswith("Note: "):
+                    body = found.group(2)[len("Note: "):].strip()
+                    number = vocab.note_number.match(body)
+                    if number:
+                        key = re.match(r"\D*(\d+)", body)
+                        notes[key.group(1) if key else body] = (found.group(1), vocab.note_number.sub("", body, count=1)
+                                                                .strip() or body)
+            continue
+        columns = _COLUMNS_LINE.match(line)
+        if columns:
+            headers = [h.strip() for h in columns.group(1).split(" | ")]
+            continue
+        found = _ID_LINE.match(line)
+        if found and headers and not found.group(2).startswith(("Note: ", "Unit controls by: ")):
+            cells = found.group(2).split(" | ")
+            if len(cells) == len(headers):
+                rows.append((found.group(1), cells, found.group(2)))
+    flush()
+
+
 def seed(dossier) -> Ledger:
     ledger = Ledger(dict(dossier.sources))
     ledger.job_name = str(getattr(dossier, "job_name", "") or "")

+_STATED_QTY = re.compile(r"\bQTY\.?\s*[:=]?\s*\(?(\d+)\)?", re.I)
+_TAG_WORDS = re.compile(r"\b[A-Z]{1,6}-[A-Z0-9.\-]*[0-9A-Z]\b")

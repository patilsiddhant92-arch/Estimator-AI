+def floor_plan_sheet(sheet) -> bool:
+    """Whether a catalogue Sheet is a new-work floor plan (or roof plan): types include "Plans" and none of the other
+    drawing kinds, the title is no enlarged / partial / room plan, and it is no demolition sheet."""
+    if sheet is None:
+        return False
+    types = set(getattr(sheet, "types", ()) or ())
+    return ("Plans" in types and not types & _NOT_FLOOR_TYPES and not demolition_sheet(sheet)
+            and not _ENLARGED.search(getattr(sheet, "title", "") or ""))
+

+def demolition_sheet(sheet) -> bool:
+    """A catalogue Sheet that is a demolition plan, read from its title block only (`Sheet.number`, `Sheet.title`,
+    never the plan's text, where "MD-1" is a motorized damper's tag and "DEMO LAB" a room): the whole word DEMO or
+    DEMOLITION in the title, or a sheet number that is all MD-x / MD### ("MD-1", "MD101")."""
+    if sheet is None:
+        return False
+    return bool(_DEMOLITION_TITLE.search(getattr(sheet, "title", "") or "")
+                or _DEMOLITION_NUMBER.fullmatch((getattr(sheet, "number", "") or "").strip()))
+
+
+def tag_state(label: str, keynote: str = "", demolition: bool = False) -> str:
+    """One tag's state from its label ("(ER) EF-4", "(E) AHU-9", "EF-3"), the keynote tied to it and whether the
+    sheet is a demolition plan."""
+    mark = re.match(r"^\s*\(\s*(ER|D|E)\s*\)", label or "", re.I)
+    if mark and mark.group(1).upper() in ("ER", "D"):
+        return REMOVED
+    if _REMOVE_KEYNOTE.search(keynote or "") and not _TO_REMAIN.search(keynote or ""):
+        return REMOVED
+    if mark:
+        return EXISTING
+    return REMOVED if demolition else NEW
+
+
+def sheet_marks(text: str) -> dict[str, str]:
+    """canonical tag -> its state on one sheet's text, for the tags the text marks: "(D)" / "(ER)" / "(E)" before the
+    tag, or a remove keynote on the tag's line. Tags the text does not mark are left out (new, or removed on a
+    demolition sheet: `counts_as_new`)."""
+    return {tag: state for tag, (state, _why) in _read_marks(text).items()}
+
+
+def mark_reasons(text: str) -> dict[str, str]:
+    """canonical tag -> why the sheet text gives it its state: 'marked "(D)"', 'a remove keynote: "..."'."""
+    return {tag: why for tag, (_state, why) in _read_marks(text).items()}
+
+
+def _read_marks(text: str) -> dict[str, tuple[str, str]]:
+    marks: dict[str, tuple[str, str]] = {}
+    for line in (text or "").splitlines():
+        line = " ".join(line.split())
+        for found in _MARKED_TAG.finditer(line):
+            tag = canonical(found.group(2))
+            state = tag_state(found.group(0), line)
+            prefix = f"({found.group(1).upper()})"
+            why = (f'marked "{prefix}" with a remove keynote: "{line}"'
+                   if state == REMOVED and prefix == "(E)" else f'marked "{prefix}"')
+            if marks.get(tag, ("",))[0] != REMOVED:
+                marks[tag] = (state, why)
+        # an unmarked tag is removed only by a keynote that says the existing item goes ("EXISTING EF-2 TO BE
+        # REMOVED"): a bare REMOVE on a new-work plan ("REMOVE AND REPLACE FILTERS, AHU-1") never drops a unit
+        if _REMOVE_KEYNOTE.search(line) and _EXISTING_WORD.search(line) and not _TO_REMAIN.search(line):
+            for tag in _LINE_TAG.findall(line):
+                if marks.get(canonical(tag), ("",))[0] != REMOVED:
+                    marks[canonical(tag)] = (REMOVED, f'a remove keynote: "{line}"')
+    return marks
+
+
+def _state(sheet, tag: str) -> str:
+    return (getattr(sheet, "marks", None) or {}).get(tag) or (
+        REMOVED if demolition_sheet(getattr(sheet, "sheet", None)) else NEW)
+
+
+def counts_as_new(sheet, tag: str) -> bool:
+    """Whether a (canonical) tag on this sheet counts as new work: new, or unknown (dashed only: kept, and asked)."""
+    return _state(sheet, tag) in (NEW, UNKNOWN)
+
+
+# a new-work floor plan, told apart by the catalogue's Sheet (read from the title block: `Sheet.types` from the
+# title by assets/reading_lists/sheet_types.json, and `Sheet.title`): a "Plans" sheet that is no other drawing kind
+# and whose title is not an enlarged or partial plan of one room
+_NOT_FLOOR_TYPES = frozenset({"Schedules", "Details", "Air riser", "Water riser", "Network riser", "Control diagrams",
+                              "Diagrams", "Sections and elevations", "Demolition"})
+_ENLARGED = re.compile(r"\bENLARGE(?:D|MENT)\b|\bPARTIAL\b|\bBLOW[- ]?UP\b|\bDETAILS?\b|\bSECTIONS?\b|\bRISERS?\b|"
+                       r"\b(?:MECHANICAL|MECH\.?|EQUIPMENT|ELECTRICAL|FAN|BOILER|PUMP|CHILLER|AHU)\s+ROOMS?\b", re.I)

+def family_schedule(family: Family, pattern: str, scheduled: dict[str, int]) -> dict[str, int]:
+    """The schedule quantities that cap and anchor one family's counts: the schedule rows' QTY cells for the tags
+    that fit its pattern (`ledger_schedule_quantities`); only when the schedule gives none of them (no qty column)
+    the "QTY n" its count quote states (`schedule_quantities`)."""
+    mine = {tag: n for tag, n in (scheduled or {}).items() if fits(pattern, tag)}
+    return mine or schedule_quantities(family)
+

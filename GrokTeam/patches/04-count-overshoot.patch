+# ---- new work, existing to remain, existing to be removed ----------------------------------------------------------
+# A tag on a plan is one of: new work (counted), existing to remain (not new work; its tie-in lines stay where the
+# sequence names it, never counted as a new unit) or existing to be removed (out). "(E)" alone is existing, usually
+# to remain, never a demolition mark: only "(ER)", "(D)", a REMOVE / "EXISTING TO BE REMOVED" keynote tied to the tag
+# (on its line), or a demolition sheet (DEMOLITION in the title, or the MD-x / MD### series) removes it. A tag drawn
+# dashed only (a mark the sheet text cannot carry; given by the picture) is unknown: still counted, and asked.
+NEW, EXISTING, REMOVED, UNKNOWN = "new", "existing", "removed", "unknown"
+_DEMOLITION_TITLE = re.compile(r"\b(?:DEMO|DEMOLITION)\b", re.I)        # never DEMONSTRATION
+_DEMOLITION_NUMBER = re.compile(r"MD[-.]?\d{1,3}(?:\.\d{1,2})?[A-Z]?", re.I)  # the whole number: MD-1, MD101, MD-2.1
+_MARKED_TAG = re.compile(r"\(\s*(ER|D|E)\s*\)\s*([A-Z]{1,6}-[A-Z0-9.\-]*[0-9A-Z])", re.I)
+_LINE_TAG = re.compile(r"\b[A-Z]{1,6}-[A-Z0-9.\-]*[0-9A-Z]\b")
+_REMOVE_KEYNOTE = re.compile(r"\bREMOVE[DS]?\b|\bTO\s+BE\s+REMOVED\b|\bDEMOLISH(?:ED)?\b", re.I)
+_TO_REMAIN = re.compile(r"\bTO\s+REMAIN\b", re.I)
+_EXISTING_WORD = re.compile(r"\bEXIST(?:ING|\.)?|\(\s*E\s*\)", re.I)

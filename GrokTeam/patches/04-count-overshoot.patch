+def ledger_schedule_quantities(ledger) -> dict[str, int]:
+    """canonical tag -> the QTY its schedule row gives (the ledger's `schedule_qty` facts, seeded from the schedule
+    rows by `estimator.ledger.seed.schedule_row_facts`, patch 08). Empty when no schedule has a qty column. The
+    highest where a tag is scheduled twice."""

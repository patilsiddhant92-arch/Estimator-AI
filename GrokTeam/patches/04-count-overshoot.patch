+def _scheduled(family: Family, tag: str) -> bool:
+    return any(ref.quote not in (LOCATED_QUOTE, SEEN_QUOTE)
+               and tag in {canonical(t) for t in _TAG_WORDS.findall(ref.quote or "")} for ref in family.count.sources)
+

+def cap_questions(pattern: str, sheets: list[_Sheet], schedule: dict[str, int], groups: dict | None = None) -> list[str]:
+    """One question per scheduled tag the schedule cap lowers, when the extra placements are on different new-work
+    floor plans ("AHU-9: 3 new placements on sheets M-1, M-2, M-3; schedule qty 1; ..."): the floors it is on
+    (one per plan group, `plan_groups`) outnumber its schedule quantity. Repeats on enlarged plans, details, risers,
+    sections or demolition sheets, or on one plan group, are capped silently."""
+    asks = []
+    for tag, qty in sorted((schedule or {}).items()):
+        floors: dict = {}                  # plan group (or the sheet) -> the sheet's number
+        for sheet in sheets:
+            if not any(canonical(t) == tag and n > 0 for t, n in (sheet.labels or {}).items()):
+                continue
+            if not fits(pattern, tag) or not counts_as_new(sheet, tag) or not floor_plan_sheet(sheet.sheet):
+                continue
+            group = (groups or {}).get(sheet.key) or sheet.key
+            floors.setdefault(group, sheet.sheet.number or sheet.place)
+        if len(floors) > qty:
+            asks.append(f"{tag}: {len(floors)} new placements on sheets {', '.join(floors.values())}; schedule qty "
+                        f"{qty}; counted {qty}. Confirm the schedule quantity.")
+    return asks
+

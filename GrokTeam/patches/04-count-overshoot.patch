+            demo = list(dict.fromkeys(w for _s, w, y in seen if y == "demolition sheet"))
+            marked = list(dict.fromkeys(f"on {w}, {y}" for _s, w, y in seen if y != "demolition sheet"))
+            parts = ([f"on demolition sheet{'s' if len(demo) > 1 else ''} {', '.join(demo)}"] if demo else [])
+            if marked:
+                parts.append(f"as removed: {'; '.join(marked)}")
+            asks.append(f"{tag} appears only {' and '.join(parts)}; it is not counted as new work. "
+                        f"Confirm it is not new.")

+def demolition_questions(family: Family, pattern: str, sheets: list[_Sheet]) -> list[str]:
+    """The plain-words questions a family's tags raise by their state, each naming the sheets and the reason: a tag
+    shown only as removed ("AHU-9 appears only on demolition sheet MD-1"; "EF-4 appears only as removed: on X-901,
+    marked "(ER)"") is not counted and asked about; a tag drawn dashed only that no schedule lists ("EF-9 appears
+    only drawn dashed, on sheet X-901") is counted and asked about (never dropped silently)."""
+    states: dict[str, list[tuple[str, str, str]]] = {}       # tag -> (state, sheet number, reason)
+    for sheet in sheets:
+        where = sheet.sheet.number if sheet.sheet is not None and getattr(sheet.sheet, "number", "") else sheet.place
+        for tag, n in (sheet.labels or {}).items():
+            if n > 0 and fits(pattern, tag):
+                key = canonical(tag)
+                state = _state(sheet, key)
+                why = (sheet.reasons or {}).get(key) or (
+                    "demolition sheet" if state == REMOVED else "drawn dashed" if state == UNKNOWN else "")
+                states.setdefault(key, []).append((state, where, why))
+    asks = []
+    for tag, seen in states.items():

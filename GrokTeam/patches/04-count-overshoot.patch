+def schedule_quantities(family: Family) -> dict[str, int]:
+    """Each unit tag (canonical) the documents give a quantity of its own -> that quantity (provisional ruling R3,
+    GrokTeam/discussion.md: the schedule count wins). Read only where it is said: a family of one unit tag whose
+    count comes from a document source (not this check's own located or seen count) quoting that tag with a stated
+    quantity ("EF-3 ... QTY 2") equal to the count. A family's representative tag with a total ("VAV-1", 5) says
+    nothing per tag. Every other tag is 1 (missing from the map)."""
+    tags = family_tags(family.tags)
+    value = family.count.value
+    if len(tags) != 1 or value is None or value < 1:
+        return {}
+    tag = canonical(tags[0])
+    for ref in family.count.sources:
+        if ref.quote in (LOCATED_QUOTE, SEEN_QUOTE):
+            continue
+        said = _STATED_QTY.search(ref.quote)
+        if said and int(said.group(1)) == value and tag in {canonical(t) for t in _TAG_WORDS.findall(ref.quote)}:
+            return {tag: value}
+    return {}
+

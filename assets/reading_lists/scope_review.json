{
  "about": "What the scope review sections of the Spec overview tab look for: potential scope AME needs to carry, and anything that shouldn't go unreviewed. Every row quotes the job word for word, or says it wasn't found; nothing is guessed. Add words here, never in code. Patterns are matched ignoring case; (?-i:...) makes a part match capitals only. A hit is judged on the words around it (the sentence, cut to about 300 characters). ruled_out_words: a hit whose words forbid the thing reads Ruled out, not Found — the strongest place that names it decides. On a mechanical or electrical page (and a Division 1 page, for the project conditions), a hit counts only when its words also carry one of the word lists named in outside_controls_needs for that section; on a controls spec page or a controls drawing it counts without, because there the controls contractor is the one being addressed. exclusions: one entry per line of the proposal template's Clarifications and its Exceptions and Exclusions (line_starts matches the start of the template line, ignoring case). A clarification is found when the job speaks about the same subject. An exclusion is found only when the same words also carry one of exclusion_verbs (or the entry's own verbs; [] = none needed) that isn't given to someone else: 'furnished by others' or 'the Owner will provide' doesn't count, because other_parties provide it.",

  "ruled_out_words": [
    "\\bnot\\s+(?:be\\s+)?allowed\\b",
    "\\bnot\\s+(?:be\\s+)?permitted\\b",
    "\\bshall\\s+not\\b",
    "\\bprohibited\\b",
    "\\bnot\\s+(?:be\\s+)?acceptable\\b",
    "\\b(?:is|are)\\s+not\\s+required\\b",
    "\\bnot\\s+be\\s+used\\b",
    "\\bno\\s+[a-z][^.;]{0,60}?\\bshall\\s+be\\b"
  ],

  "controls_party_words": [
    "\\b(?:BMS|BAS|ATC|DDC|EMS|EPMS|controls?|temperature\\s+controls?|automation|integration|instrumentation)\\s+(?:installation\\s+)?(?:contractors?|subcontractors?|vendors?|providers?|integrators?|installers?)\\b",
    "\\bDivision\\s+25\\b",
    "\\bSection\\s+23\\s?09",
    "\\b23\\s?09\\s?(?:00|13|23|93)\\b",
    "(?-i:\\bDSI\\b)",
    "(?-i:\\bCSI\\b)(?!\\s+(?:MasterFormat|[Ff]ormat|[Dd]ivision|[Ss]ection|[Nn]umber))",
    "(?-i:\\bPSI\\b)(?<![\\d(]PSI)(?<!\\d\\sPSI)(?![)GA])",
    "(?-i:\\bSSI\\b)",
    "(?-i:\\bMSI\\b)",
    "\\bsystems?\\s+integrators?\\b",
    "(?-i:\\bTCC\\b)",
    "\\bI\\s*&\\s*C\\s+contractors?\\b"
  ],

  "controls_words": [
    "(?-i:\\bBMS\\b)", "(?-i:\\bBAS\\b)", "(?-i:\\bATC\\b)", "(?-i:\\bDDC\\b)", "(?-i:\\bEPMS\\b)", "\\bSCADA\\b",
    "\\bbuilding\\s+(?:automation|management)\\b",
    "\\btemperature\\s+control(?!ler)",
    "\\bcontrols?\\s+contractor\\b",
    "\\bcontrol\\s+(?:panel|wiring|device|system)s?\\b"
  ],

  "responsibility_words": [
    "\\b(?:sub)?contractors?\\b",
    "\\bbidders?\\b",
    "\\bresponsib\\w*",
    "\\ball\\s+trades\\b",
    "\\beach\\s+trade\\b",
    "\\bvendors?\\b"
  ],

  "outside_controls_needs": {
    "exclusions": ["controls_party_words"],
    "who_does_what": ["controls_party_words", "controls_words"],
    "integrations": ["controls_party_words", "controls_words"],
    "services": ["controls_party_words"],
    "special_systems": ["controls_party_words", "controls_words"],
    "conditions": ["controls_party_words", "responsibility_words"]
  },

  "exclusion_verbs": [
    "\\bfurnish\\w*",
    "\\bprovid\\w*",
    "\\binstall\\w*",
    "\\bsuppl(?:y|ied|ies|ying)\\b",
    "\\binclud\\w*",
    "\\bresponsible\\s+for\\b",
    "\\bresponsibility\\s+of\\b",
    "\\bshall\\s+be\\s+by\\b"
  ],

  "other_parties": [
    "others?",
    "(?:the\\s+)?owner(?:'s|’s)?",
    "(?:the\\s+)?(?:mechanical|electrical|plumbing|general|sprinkler|fire\\s+alarm|telecom\\w*|balancing|cabling|structured\\s+cabling)\\s+(?:sub)?contractors?",
    "(?:the\\s+)?(?:test(?:ing)?,?\\s+(?:adjusting,?\\s+)?and\\s+balancing|TAB)\\s+(?:sub)?contractors?",
    "(?:Division|Div\\.?)\\s+(?:0?1|2[2-3]|2[6-8]|3[1-3])\\b",
    "(?-i:(?:the\\s+)?(?:EC|MC|GC|PC|E\\.C\\.|M\\.C\\.|G\\.C\\.))(?![A-Za-z])",
    "(?:the\\s+)?(?:unit|equipment)\\s+(?:manufacturers?|vendors?|suppliers?)",
    "(?:the\\s+)?manufacturers?",
    "(?-i:OEMs?)",
    "(?:the\\s+)?(?:architect|tenant|landlord|utility)"
  ],

  "exclusions": [
    {"line_starts": "All labor will be performed during normal business working hours",
     "patterns": ["\\b(?:normal|regular)\\s+(?:business\\s+)?(?:working\\s+)?hours\\b", "\\boff[- ]hours?\\b", "\\bafter[- ]hours\\b", "\\bovertime\\b", "\\b(?:night|weekend|evening)s?\\s+(?:work|shifts?)\\b", "\\bnights?\\s+(?:and|or)\\s+weekends?\\b", "\\bpremium\\s+time\\b"]},
    {"line_starts": "All Motor starters require Hand-Off-Auto switches",
     "patterns": ["\\bhand[- ]off[- ]auto\\b", "(?-i:\\bH-?O-?A\\b)", "\\bstarters?\\b[^.;]{0,60}\\bcontrol\\s+(?:power\\s+)?transformers?\\b", "\\bcontrol\\s+(?:power\\s+)?transformers?\\b[^.;]{0,60}\\bstarters?\\b"]},
    {"line_starts": "All Motor starters and/or variable frequency drive are to be located",
     "patterns": ["\\b(?:starters?|VFDs?|variable\\s+(?:frequency|speed)\\s+drives?)\\b[^.;]{0,80}\\b(?:located|mounted)\\b[^.;]{0,40}\\b(?:within\\s+sight|in\\s+sight|vicinity|adjacent|near)\\b", "\\bremote(?:ly)?[- ](?:located|mounted)\\s+(?:VFDs?|drives?|starters?)\\b", "\\b(?:VFDs?|variable\\s+(?:frequency|speed)\\s+drives?)\\b[^.;]{0,40}\\bremote(?:ly)?\\s+(?:located|mounted)\\b"]},
    {"line_starts": "The Division 23 BMS electrical work shall be performed in accordance",
     "patterns": [], "why_not_searched": "A heading for the conduit, cable and power lines below it, which are searched one by one."},
    {"line_starts": "All new wiring in exposed or wiring in machine equipment rooms",
     "patterns": ["\\bexposed\\b[^.;]{0,60}\\b(?:EMT|conduits?|raceways?)\\b", "\\b(?:mechanical|equipment|machine)\\s+(?:equipment\\s+)?rooms?\\b[^.;]{0,60}\\b(?:EMT|conduits?)\\b", "\\b(?:EMT|conduits?)\\b[^.;]{0,60}\\b(?:exposed|mechanical\\s+(?:equipment\\s+)?rooms?|equipment\\s+rooms?)\\b"]},
    {"line_starts": "All new wiring in exterior areas",
     "patterns": ["\\bRGS\\b", "\\brigid\\s+(?:galvanized\\s+)?(?:steel\\s+)?conduits?\\b", "\\bgalvanized\\s+(?:rigid|steel|EMT)\\b", "\\b(?:exterior|outdoors?|weather)\\b[^.;]{0,60}\\b(?:conduits?|EMT|raceways?)\\b", "\\bliquid[- ]?tight\\b"]},
    {"line_starts": "All unexposed low voltage wiring outside of the mechanical equipment rooms",
     "patterns": ["\\bplenum[- ]?(?:rated|cable|cabling)\\b", "(?-i:\\bCMP\\b)", "\\ball\\s+(?:control\\s+|low[- ]voltage\\s+|BMS\\s+|BAS\\s+)?(?:wiring|cabling|cables?)\\s+shall\\s+be\\s+(?:installed\\s+|run\\s+)?in\\s+(?:EMT|conduits?|raceways?)\\b"]},
    {"line_starts": "The fire stopping of the new BMS control wiring is included",
     "patterns": ["\\bfire\\s*-?stop(?:ping|ped)?\\b", "\\bfire[- ]?seal\\w*\\b", "\\bpenetrations?\\b[^.;]{0,40}\\bfire[- ]?rated\\b"]},
    {"line_starts": "The Division 26 EC shall deliver a designated power source",
     "patterns": ["\\b(?:120\\s*V(?:AC)?|power)\\b[^.;]{0,60}\\b(?:BMS|BAS|DDC|ATC|controls?|PLC)\\s+(?:control\\s+)?panels?\\b", "\\b(?:BMS|BAS|DDC|controls?|PLC)\\s+(?:control\\s+)?panels?\\b[^.;]{0,60}\\b(?:120\\s*V|power\\s+(?:source|circuits?|supply|feeds?))\\b", "\\bdedicated\\s+(?:120\\s*V\\s+)?(?:power\\s+)?circuits?\\b"]},

    {"line_starts": "All off-hours or overtime labor",
     "patterns": ["\\boff[- ]hours?\\b", "\\bafter[- ]hours\\b", "\\bovertime\\b", "\\b(?:night|weekend|evening|second|third)[- ](?:shifts?|work)\\b", "\\bnights?\\s+(?:and|or)\\s+weekends?\\b", "\\bpremium\\s+time\\b"],
     "verbs": ["\\bshall\\b", "\\bwill\\b", "\\bmust\\b", "\\brequired\\b", "\\bperform\\w*", "\\bprovid\\w*", "\\binclud\\w*"]},
    {"line_starts": "All temporary heating or cooling",
     "patterns": ["\\btemporary\\s+(?:heat(?:ing)?|cooling|HVAC|conditioning|controls?)\\b", "\\b(?:use|operation)\\s+of\\s+(?:the\\s+)?permanent\\s+(?:HVAC|equipment|systems?)\\b"]},
    {"line_starts": "All equipment manufacturer integration/communication devices",
     "patterns": ["\\bgateways?\\b", "\\bprotocol\\s+(?:converters?|translators?)\\b", "\\b(?:communication|interface|network|BACnet|Modbus|integration)\\s+(?:cards?|modules?|devices?|boards?)\\b"]},
    {"line_starts": "All equipment manufacturer wall sensor guards",
     "patterns": ["\\b(?:sensor|thermostat)\\s+(?:guards?|covers?|cages?)\\b", "\\b(?:wire|protective|tamper[- ]?proof|locking|vandal[- ]?proof)\\s+(?:guards?|covers?|cages?)\\b", "\\b(?:guards?|cages?)\\b[^.;]{0,30}\\b(?:sensors?|thermostats?)\\b"]},
    {"line_starts": "The integration and communications into competitive building management systems",
     "patterns": ["\\bexisting\\s+(?:BMS|BAS|EMS|DDC|building\\s+(?:management|automation)\\s+systems?|front[- ]end|(?:head[- ]end))\\b", "\\b(?:integrat\\w*|interface|connect\\w*|tie)\\s+(?:in)?(?:to|with)\\s+(?:the\\s+)?existing\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binstall\\w*", "\\binclud\\w*", "\\bintegrat\\w*", "\\binterfac\\w*", "\\bconnect\\w*", "\\btie\\b", "\\bextend\\w*"]},
    {"line_starts": "The cost of material & setup of the third party communication devices",
     "patterns": ["\\bthird[- ]party\\b[^.;]{0,60}\\b(?:devices?|gateways?|interfaces?|systems?|equipment|controllers?)\\b"]},
    {"line_starts": "All water flow and/or air flow balancing and calibration",
     "patterns": ["\\b(?:air|water|hydronic)\\s*(?:flow\\s+)?balanc\\w*\\b", "\\btest(?:ing)?,?\\s+(?:adjust(?:ing)?,?\\s+)?and\\s+balanc\\w*", "\\bcalibrat\\w*\\b[^.;]{0,40}\\b(?:air\\s*flow|water\\s*flow|flow\\s+stations?|flow\\s*meters?)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bperform\\w*", "\\bresponsible\\s+for\\b"]},
    {"line_starts": "The installation of dampers, valves, wells, water flow meters",
     "patterns": ["\\b(?:control\\s+|motorized\\s+|automatic\\s+)?dampers?\\b", "\\b(?:control\\s+)?valves?\\b", "\\b(?:thermo|immersion\\s+|sensor\\s+)wells?\\b", "\\bwells\\b", "\\bflow\\s*meters?\\b", "\\bair\\s*flow\\s+(?:measuring\\s+|monitoring\\s+|measurement\\s+)?stations?\\b", "(?-i:\\bAFMS\\b)"],
     "verbs": ["\\binstall\\w*", "\\bmount(?:ed|ing)?\\s+in\\b"]},
    {"line_starts": "The installation of control valves, piping taps and thread-o-lets",
     "patterns": ["\\bcontrol\\s+valves?\\b", "\\b(?:piping|pipe|pressure)\\s+taps?\\b", "\\bthread-?o-?lets?\\b", "\\bweld-?o-?lets?\\b"],
     "verbs": ["\\binstall\\w*", "\\btap\\w*\\s+(?:in|into)\\b"]},
    {"line_starts": "All power wiring of mechanical equipment",
     "patterns": ["\\bpower\\s+wiring\\b", "\\b(?:line|high)[- ]voltage\\s+(?:power\\s+)?wiring\\b", "\\b(?:208|230|277|480)\\s*V(?:AC)?\\s+(?:power\\s+)?(?:wiring|circuits?|feeds?)\\b"]},
    {"line_starts": "EMT or RGS conduit (if specified) other than exterior areas",
     "patterns": ["\\b(?:BMS|BAS|ATC|DDC|controls?|low[- ]voltage|temperature\\s+control)\\s+(?:wiring\\s+|cabling\\s+|cable\\s+)?conduits?\\b", "\\bconduits?\\b[^.;]{0,40}\\b(?:blue|colou?r(?:ed)?)\\b", "\\b(?:wiring|cabling|cables?)\\s+(?:shall\\s+be\\s+)?(?:installed\\s+|run\\s+|routed\\s+)?in\\s+(?:EMT|conduits?|raceways?)\\b", "\\bEMT\\b", "\\bRGS\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binstall\\w*", "\\binclud\\w*", "\\bresponsib\\w*", "\\bshall\\s+be\\b", "\\bmust\\s+be\\b", "\\bin\\s+(?:EMT|conduits?)\\b"]},
    {"line_starts": "Any computers and/or related equipment",
     "patterns": ["\\b(?:personal\\s+)?computers?\\b", "\\b(?:operator\\s+)?work\\s*stations?\\b", "\\bservers?\\b(?!\\s*(?:rooms?|areas?))", "\\bprinters?\\b", "\\brouters?\\b", "\\blaptops?\\b", "(?-i:\\bPCs?\\b)", "\\b(?:LCD|LED)\\s+(?:monitors?|displays?)\\b", "\\bfirewalls?\\b"]},
    {"line_starts": "All mechanical equipment (i.e. AHU, VAV, Pumps, VFDs, etc.)",
     "patterns": ["\\b(?:furnish|provide|supply)\\w*\\s+(?:the\\s+|all\\s+)?(?:VAV\\s+box(?:es)?|(?:air\\s+)?terminal\\s+units?|air\\s+handling\\s+units?|AHUs?|pumps?|exhaust\\s+fans?|fan\\s+coil\\s+units?)\\b(?!\\s+(?:controllers?|controls?|sensors?|status|starters?|interlocks?|points?))"]},
    {"line_starts": "All air flow monitoring station",
     "patterns": ["\\bair\\s*flow\\s+(?:measuring|monitoring|measurement)\\s+(?:stations?|arrays?|devices?)\\b", "(?-i:\\bAFMS\\b)", "\\bair\\s*flow\\s+stations?\\b"]},
    {"line_starts": "All water flow meters",
     "patterns": ["\\bflow\\s*meters?\\b", "\\b(?:electromagnetic|magnetic|ultrasonic|insertion|inline)\\s+(?:flow\\s*)?meters?\\b"]},
    {"line_starts": "All electric power meters",
     "patterns": ["\\b(?:electric(?:al)?|power(?:\\s+quality)?|energy|kWh|kW|revenue)\\s+meters?\\b", "\\bsub-?meter\\w*\\b", "(?-i:\\bPQMs?\\b)", "\\bpower\\s+monitors?\\b"]},
    {"line_starts": "All gas meters",
     "patterns": ["\\bgas\\s+(?:flow\\s+)?meters?\\b"]},
    {"line_starts": "All motor starters",
     "patterns": ["\\b(?:motor|magnetic|combination)\\s+starters?\\b(?!\\s+(?:status|auxiliary|contacts?|coils?|interlocks?))"]},
    {"line_starts": "All variable frequency drives",
     "patterns": ["\\b(?:variable\\s+(?:frequency|speed)\\s+drives?|(?-i:VFDs?)|(?-i:VSDs?))\\b(?!\\s+(?:status|speed|signals?|interface|integration|points?|alarms?|feedback|controllers?|start|commands?|outputs?|inputs?|configuration))"]},
    {"line_starts": "Any equipment housekeeping pads",
     "patterns": ["\\bhousekeeping\\s+pads?\\b", "\\b(?:concrete|equipment)\\s+pads?\\b"]},
    {"line_starts": "The Boiler Control Panel and associated control devices",
     "patterns": ["\\bboiler\\s+(?:control\\s+)?panels?\\b", "\\bboiler\\s+(?:plant\\s+)?(?:controls?|controllers?|management\\s+system|sequencers?)\\b"]},
    {"line_starts": "Any gas detection system or components",
     "patterns": ["\\bgas\\s+(?:detection|detectors?|monitoring|sensors?)\\b", "\\b(?:hydrogen|(?-i:H2))\\s+(?:gas\\s+)?(?:detection|detectors?|sensors?|monitor\\w*)\\b", "\\brefrigerant\\s+(?:leak\\s+)?(?:detection|detectors?|monitor\\w*|sensors?)\\b", "\\b(?:carbon\\s+monoxide|(?-i:CO)|(?-i:NO2)|nitrogen\\s+dioxide)\\s+(?:detection|detectors?|sensors?|monitor\\w*)\\b", "\\b(?:combustible|toxic)\\s+gas\\b"]},
    {"line_starts": "Any demolition work not mentioned",
     "patterns": ["\\bdemoli\\w*\\b", "\\b(?:remov\\w*|removal\\s+of)\\s+(?:all\\s+)?(?:the\\s+)?(?:existing|abandoned|obsolete)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bremov\\w*", "\\bdemolish\\w*", "\\bdisconnect\\w*"]},
    {"line_starts": "All fire alarm system or components",
     "patterns": ["\\bsmoke\\s+detectors?\\b", "\\bduct\\s+(?:smoke\\s+)?detectors?\\b", "\\bfire\\s*/\\s*smoke\\s+dampers?\\b", "\\bcombination\\s+fire\\s+(?:and\\s+|/\\s*)?smoke\\s+dampers?\\b", "\\bsmoke\\s+dampers?\\b", "\\bfire\\s+alarm\\s+(?:system|panels?|components?|devices?|wiring|relays?)\\b", "(?-i:\\bFACP\\b)"]},
    {"line_starts": "Installation and maintenance of any high-speed internet connections",
     "patterns": ["\\binternet\\s+(?:connections?|service|access)\\b", "\\bhigh[- ]speed\\s+internet\\b", "\\bbroadband\\b", "\\bcellular\\s+(?:modems?|routers?|connections?)\\b"]},
    {"line_starts": "All control dampers",
     "patterns": ["\\bcontrol\\s+dampers?\\b", "\\b(?:motorized|automatic|modulating|isolation|outside\\s+air|return\\s+air|relief)\\s+dampers?\\b"]},
    {"line_starts": "Any site excavation and/or trenching",
     "patterns": ["\\bexcavat\\w*\\b", "\\btrench\\w*\\b", "\\bunderground\\s+(?:conduits?|duct\\s*banks?|raceways?)\\b", "\\bdirect[- ]burial\\b"]},
    {"line_starts": "All cutting, patching, and/or painting",
     "patterns": ["\\bcutting\\s*(?:and|&|,)\\s*patching\\b", "\\bpatching\\b", "\\b(?:touch[- ]up\\s+)?painting\\b", "\\bpaint\\s+(?:all\\s+)?(?:exposed\\s+)?(?:conduits?|raceways?|piping|surfaces?)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bshall\\s+(?:\\w+\\s+)?(?:cut|patch|paint|repair)\\w*"]},
    {"line_starts": "Any core drilling of floors, walls and/or partitions",
     "patterns": ["\\bcore[- ]?drill\\w*\\b", "\\bcoring\\b", "\\b(?:sleeves?|penetrations?)\\s+(?:through|in)\\s+(?:the\\s+)?(?:floors?|walls?|slabs?|partitions?)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binstall\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bdrill\\w*"]},
    {"line_starts": "Any roof penetrations, pitch pockets required",
     "patterns": ["\\broof\\s+penetrations?\\b", "\\bpitch\\s+pockets?\\b", "\\broof\\s+(?:curbs?|jacks?|flashing)\\b", "\\bpenetrat\\w*\\s+(?:through\\s+)?(?:the\\s+)?roof\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binstall\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bpenetrat\\w*"]},
    {"line_starts": "Any costs associated for factory-mounting and wiring of AME provided devices",
     "patterns": ["\\bfactory[- ](?:mount\\w*|install\\w*|wir\\w*)\\b", "\\bshipped\\s+(?:loose\\s+)?to\\s+(?:the\\s+)?(?:unit|equipment)\\s+manufacturers?\\b", "\\b(?:unit|equipment)\\s+manufacturers?\\s+(?:shall|to)\\s+(?:mount|install|wire)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binstall\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bship\\w*", "\\bmount\\w*"]},
    {"line_starts": "All site cleanup back-up charges",
     "patterns": ["\\bback[- ]?charges?\\b", "\\bclean[- ]?up\\s+charges?\\b", "\\bdaily\\s+clean[- ]?up\\b", "\\bremov\\w*\\s+(?:all\\s+)?(?:debris|rubbish|trash)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bcharged?\\b", "\\bremov\\w*", "\\bclean\\w*"]},
    {"line_starts": "Any checkout, repair, replacement, or warranty of existing controlled equipment",
     "patterns": ["\\bexisting\\s+(?:\\w+\\s+){0,3}(?:equipment|devices?|controllers?|sensors?|actuators?|valves?|dampers?|controls?)\\b[^.;]{0,60}\\b(?:repair|replac|check\\s*out|survey|verif|warrant|reus|re-us)\\w*", "\\b(?:repair|replac|check\\s*out|survey|verif|test)\\w*\\s+(?:all\\s+)?(?:of\\s+)?(?:the\\s+)?existing\\s+(?:\\w+\\s+){0,3}(?:equipment|devices?|controllers?|sensors?|actuators?|valves?|dampers?|controls?)\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\b(?:repair|replac|survey|verif|check|test|reus|re-us)\\w*"]},
    {"line_starts": "Any bid, performance, maintenance, or payment bonds",
     "patterns": ["\\b(?:bid|performance|payment|maintenance|surety|labor\\s+and\\s+material)\\s+bonds?\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\brequired\\b", "\\bsubmit\\w*"]},
    {"line_starts": "Any Taxes and/or Permit Fees",
     "patterns": ["\\bsales\\s+tax\\w*\\b", "\\btaxes\\b", "\\bpermit\\s+fees?\\b", "\\b(?:obtain|secure|pay\\s+for|apply\\s+for)\\w*\\s+(?:all\\s+)?(?:the\\s+)?(?:required\\s+|necessary\\s+|applicable\\s+)?(?:building\\s+|electrical\\s+)?permits?\\b", "\\b(?:filing|inspection)\\s+fees?\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bresponsible\\s+for\\b", "\\bpay\\w*", "\\bobtain\\w*", "\\bsecure\\b"]},
    {"line_starts": "All project allowances",
     "patterns": ["\\ballowances?\\b"],
     "verbs": ["\\bfurnish\\w*", "\\bprovid\\w*", "\\binclud\\w*", "\\bcarry\\b", "\\bresponsible\\s+for\\b"]},
    {"line_starts": "Any demolition work not specifically mentioned",
     "patterns": [], "why_not_searched": "The same line as \"Any demolition work not mentioned\" earlier in the list, which is searched."}
  ],

  "who_does_what": {
    "limit": 60,
    "patterns": [
      "\\bby\\s+others\\b",
      "\\bby\\s+(?:the\\s+)?owner\\b",
      "\\bowner[- ](?:furnished|provided|supplied|installed)\\b",
      "\\b(?:furnished|provided|supplied|installed|performed|done|wired)\\s+by\\s+(?:the\\s+)?(?:owner|others|(?:mechanical|electrical|general|plumbing|telecom\\w*|fire\\s+alarm)\\s+(?:sub)?contractors?|(?:Division|Div\\.?)\\s+(?:2[2-3]|2[6-8])\\b|(?:unit|equipment)\\s+(?:manufacturers?|vendors?|suppliers?))",
      "\\bby\\s+(?:the\\s+)?(?:mechanical|electrical|plumbing|general|telecom\\w*|fire\\s+alarm)\\s+(?:sub)?contractors?\\b",
      "\\bby\\s+(?:Division|Div\\.?)\\s+(?:2[2-3]|2[6-8])\\b",
      "\\bby\\s+(?:the\\s+)?(?:unit|equipment)\\s+(?:manufacturers?|vendors?|suppliers?)\\b",
      "\\bby\\s+(?:the\\s+)?(?-i:(?:EC|MC|GC|E\\.C\\.|M\\.C\\.|G\\.C\\.))(?![A-Za-z])",
      "(?-i:\\bOF(?:CI|OI|E)\\b)",
      "\\bfurnished\\s+by\\b[^.;]{0,80}\\binstalled\\s+by\\b",
      "\\b(?:the\\s+)?owner\\s+(?:will|shall|to)\\s+(?:provide|furnish|supply|install|procure)\\b",
      "(?-i:\\bN\\.?I\\.?C\\.?(?![A-Za-z]))",
      "\\bnot\\s+in\\s+contract\\b"
    ],
    "matrix": [
      "\\bresponsibility\\s+(?:matri(?:x|ces)|schedules?|charts?|tables?)\\b",
      "\\bdivision\\s+of\\s+responsibilit(?:y|ies)\\b",
      "\\bscope\\s+matri(?:x|ces)\\b"
    ],
    "split_names": [
      {"name": "DSI", "patterns": ["(?-i:\\bDSI\\b)", "\\bdesign\\s+systems?\\s+integrators?\\b"]},
      {"name": "CSI", "patterns": ["(?-i:\\bCSI\\b)(?!\\s+(?:MasterFormat|[Ff]ormat|[Dd]ivision|[Ss]ection|[Nn]umber))", "\\bconstruction\\s+systems?\\s+integrators?\\b"]},
      {"name": "PSI", "patterns": ["(?-i:\\bPSI\\b)(?<![\\d(]PSI)(?<!\\d\\sPSI)(?![)GA])", "\\bpanel\\s+(?:hardware\\s+engineering\\s+)?systems?\\s+integrators?\\b"]},
      {"name": "SSI", "patterns": ["(?-i:\\bSSI\\b)", "\\bSCADA\\s+systems?\\s+integrators?\\b"]},
      {"name": "MSI", "patterns": ["(?-i:\\bMSI\\b)", "\\bmaster\\s+systems?\\s+integrators?\\b"]},
      {"name": "system integrator", "patterns": ["\\bs(?<!master\\ss)(?<!design\\ss)(?<!construction\\ss)(?<!panel\\ss)(?<!scada\\ss)ystems?\\s+integrators?\\b"]}
    ],
    "split_defined": [
      "\\((?-i:DSI|CSI|PSI|SSI|MSI)\\)",
      "(?-i:\\b(?:DSI|CSI|PSI|SSI|MSI))\\s*[-–:=]\\s*[A-Za-z]",
      "\\b(?:design|construction|panel|SCADA|master)\\s+systems?\\s+integrators?\\b"
    ]
  },

  "integrations": {
    "words": [
      "\\bintegrat\\w*", "\\binterfac\\w*", "\\bmonitor\\w*", "\\bmap(?:ped|ping|s)?\\b", "\\bpoints?\\b",
      "\\bModbus\\b", "\\bBACnet\\b", "\\bgateways?\\b", "\\bconnect(?:ed|ion)?\\s+(?:in)?to\\s+(?:the\\s+)?(?:BMS|BAS|EPMS|SCADA|DDC|building\\s+(?:automation|management)\\s+system)\\b",
      "\\bhard[- ]?wired\\b", "\\bEtherNet\\s*/\\s*IP\\b", "\\bSNMP\\b", "\\bOPC(?:[- ]UA)?\\b", "\\bdry\\s+contacts?\\b"
    ],
    "protocols": [
      {"name": "Modbus TCP", "family": "Modbus", "patterns": ["\\bModbus\\s*(?:/\\s*|-\\s*)?TCP\\b"]},
      {"name": "Modbus RTU", "family": "Modbus", "patterns": ["\\bModbus\\s*(?:/\\s*|-\\s*)?RTU\\b"]},
      {"name": "Modbus (TCP or RTU not stated)", "family": "Modbus", "fallback": true, "patterns": ["\\bModbus\\b"]},
      {"name": "BACnet/IP", "family": "BACnet", "patterns": ["\\bBACnet\\s*/?\\s*IP\\b", "\\bB/IP\\b"]},
      {"name": "BACnet MS/TP", "family": "BACnet", "patterns": ["\\bMS\\s*/?\\s*TP\\b"]},
      {"name": "BACnet (IP or MS/TP not stated)", "family": "BACnet", "fallback": true, "patterns": ["\\bBACnet\\b"]},
      {"name": "EtherNet/IP", "family": "EtherNet/IP", "patterns": ["\\bEtherNet\\s*/\\s*IP\\b"]},
      {"name": "hardwired", "family": "hardwired", "patterns": ["\\bhard[- ]?wired\\b", "\\bdry\\s+contacts?\\b"]}
    ],
    "systems": [
      {"item": "UPS (uninterruptible power supply)", "patterns": ["(?<!-)\\b(?-i:UPS)\\b", "\\buninterruptible\\s+power\\b"]},
      {"item": "Static transfer switches", "patterns": ["\\bstatic\\s+transfer\\s+switch(?:es)?\\b", "(?-i:\\bSTS\\b)"]},
      {"item": "Automatic transfer switches", "patterns": ["\\bautomatic\\s+transfer\\s+switch(?:es)?\\b", "(?-i:\\bATS\\b)"]},
      {"item": "Switchgear and switchboards", "patterns": ["\\bswitch\\s*gear\\b", "\\bswitch\\s*boards?\\b", "(?-i:\\bSWGR\\b)", "(?-i:\\bSWBD\\b)"]},
      {"item": "Generators", "patterns": ["\\bgenerators?\\b", "\\bgen[- ]?sets?\\b", "(?-i:\\bGEN-)"]},
      {"item": "Transformers", "patterns": ["(?<!control\\s)\\btransformers?\\b", "(?-i:\\bXFMRS?\\b)", "(?-i:\\bXFMR-)"]},
      {"item": "Power meters and power quality meters", "patterns": ["\\b(?:power|energy|electric(?:al)?|kWh)\\s+(?:quality\\s+)?meters?\\b", "(?-i:\\bPQMs?\\b)", "\\bpower\\s+monitor(?:s|ing)?\\b"]},
      {"item": "Power distribution units and remote power panels", "patterns": ["\\bpower\\s+distribution\\s+units?\\b", "(?-i:\\bPDUs?\\b)", "\\bremote\\s+power\\s+panels?\\b", "(?-i:\\bRPPs?\\b)"]},
      {"item": "Lighting controls", "patterns": ["\\blighting\\s+(?:controls?|control\\s+systems?|control\\s+panels?|relay\\s+panels?)\\b"]},
      {"item": "Fire alarm", "patterns": ["\\bfire\\s+alarm\\b", "(?-i:\\bFACP\\b)"]},
      {"item": "Access control and security", "patterns": ["\\baccess\\s+control\\b", "\\bsecurity\\s+systems?\\b", "\\bcard\\s+access\\b"]},
      {"item": "Elevators", "patterns": ["\\belevators?\\b", "\\bescalators?\\b"]},
      {"item": "Leak detection", "patterns": ["\\b(?:water\\s+|liquid\\s+|fluid\\s+)?leak\\s+(?:detection|detectors?|sensors?)\\b", "\\brope\\s+(?:type\\s+)?(?:leak|sensors?|cables?)\\b", "(?-i:\\bLD\\s+(?:PNLS?|PANELS?)\\b)"]},
      {"item": "Hydrogen detection", "patterns": ["\\bhydrogen\\s+(?:gas\\s+)?(?:detection|detectors?|sensors?|monitor\\w*)\\b", "(?-i:\\bH2\\s+(?:DETECT\\w*|SENSORS?|[Dd]etect\\w*|[Ss]ensors?))"]},
      {"item": "Refrigerant detection", "patterns": ["\\brefrigerant\\s+(?:leak\\s+)?(?:detection|detectors?|monitor\\w*|sensors?|alarms?)\\b"]},
      {"item": "Gas detection", "patterns": ["\\b(?:gas|combustible\\s+gas|toxic\\s+gas|carbon\\s+monoxide|(?-i:CO)|(?-i:NO2)|nitrogen\\s+dioxide)\\s+(?:detection|detectors?|monitor\\w*|sensors?)\\b"]},
      {"item": "Chillers", "patterns": ["\\bchillers?\\b", "(?-i:\\bCHLRS?\\b)"]},
      {"item": "Boilers", "patterns": ["\\bboilers?\\b"]},
      {"item": "Computer room air units (handlers and conditioners)", "patterns": ["\\bcomputer\\s+room\\s+(?:air\\s+)?(?:handlers?|handling\\s+units?|conditioners?|air\\s+conditioning\\s+units?|units?)\\b", "(?-i:\\bCRA[HC]S?\\b)"]},
      {"item": "Humidifiers", "patterns": ["\\bhumidifiers?\\b", "\\bhumidification\\s+(?:systems?|units?)\\b"]},
      {"item": "Variable frequency drives", "patterns": ["\\bvariable\\s+(?:frequency|speed)\\s+drives?\\b", "(?-i:\\bVFDs?\\b)", "(?-i:\\bVSDs?\\b)"]},
      {"item": "Heat trace", "patterns": ["\\bheat\\s+trac(?:e|ing)\\b", "(?-i:\\bHT\\s+PANELS?\\b)"]},
      {"item": "Domestic water meters", "patterns": ["\\bdomestic\\s+(?:cold\\s+)?water\\s+meters?\\b", "\\bwater\\s+meters?\\b", "(?-i:\\bDWM\\b)"]},
      {"item": "Lift stations and sewage ejectors", "patterns": ["\\blift\\s+stations?\\b", "\\bsewage\\s+ejectors?\\b", "\\bejector\\s+pumps?\\b"]},
      {"item": "Reverse osmosis", "patterns": ["\\breverse\\s+osmosis\\b"]},
      {"item": "Sump pumps", "patterns": ["\\bsump\\s+pumps?\\b", "\\bsump\\s+pits?\\b"]},
      {"item": "Glycol system", "patterns": ["\\bglycol\\b"]},
      {"item": "Fuel oil system", "patterns": ["\\bfuel\\s+oil\\b", "\\bdiesel\\s+(?:fuel|tanks?|day\\s+tanks?)\\b", "\\bday\\s+tanks?\\b", "\\bfuel\\s+(?:tanks?|polishing|systems?|monitoring)\\b"]},
      {"item": "Water treatment", "patterns": ["\\bwater\\s+treatment\\b", "\\bchemical\\s+(?:treatment|feed)\\b", "\\bconductivity\\s+controllers?\\b"]},
      {"item": "Kitchen hoods", "patterns": ["\\bkitchen\\s+(?:exhaust\\s+)?hoods?\\b", "\\bhood\\s+(?:controls?|control\\s+panels?|control\\s+systems?)\\b", "\\bkitchen\\s+ventilation\\b"]},
      {"item": "Snow melt", "patterns": ["\\bsnow\\s*-?melt\\w*\\b"]},
      {"item": "Solar panels", "patterns": ["\\bsolar\\b", "\\bphotovoltaic\\b", "(?-i:\\bPV\\s+(?:system|array|panel|inverter|SYSTEM|ARRAY|PANEL|INVERTER)s?\\b)"]},
      {"item": "Thermal energy (BTU) meters", "patterns": ["\\b(?:BTU|thermal\\s+energy|chilled\\s+water\\s+energy)\\s+meters?\\b"]}
    ]
  },

  "services": [
    {"item": "Training", "patterns": ["\\btraining\\b", "\\binstruction(?:al)?\\s+(?:sessions?|periods?)\\b"],
     "amount": ["(?:\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|twelve|sixteen|twenty|twenty-four|thirty|forty)\\s+)?\\(?\\d+\\)?\\s*(?:hours?|hrs?)\\b", "(?:\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|twelve)\\s+)?\\(?\\d+\\)?\\s*(?:sessions?|days?)\\b"]},
    {"item": "Commissioning", "patterns": ["\\bcommissioning\\b", "\\bcommissioning\\s+(?:agent|authority|provider)\\b"]},
    {"item": "Functional performance testing", "patterns": ["\\bfunctional\\s+(?:performance\\s+)?test\\w*\\b", "(?-i:\\bFPTs?\\b)", "\\bintegrated\\s+systems?\\s+test\\w*\\b"]},
    {"item": "Point-to-point checkout", "patterns": ["\\bpoint[- ]to[- ]point\\b", "(?-i:\\bP2P\\b)", "\\bpoint\\s+check\\s*-?outs?\\b"]},
    {"item": "Trend logging", "patterns": ["\\btrend\\s*(?:logs?|logging|data|reports?|collection)\\b", "\\btrending\\b"]},
    {"item": "Warranty", "patterns": ["\\bwarrant(?:y|ies)\\b", "\\bguarantee\\b"],
     "amount": ["\\b(?:\\d+|one|two|three|four|five)[\\s-]*(?:\\(\\d+\\)[\\s-]*)?(?:years?|months?)\\b"]},
    {"item": "Service or maintenance agreement", "patterns": ["\\b(?:service|maintenance)\\s+(?:agreements?|contracts?|plans?)\\b", "\\bpreventive\\s+maintenance\\b", "\\bextended\\s+service\\b"],
     "amount": ["\\b(?:\\d+|one|two|three|four|five)[\\s-]*(?:\\(\\d+\\)[\\s-]*)?(?:years?|months?)\\b"]},
    {"item": "As-built drawings", "patterns": ["\\bas[- ]built\\w*\\b", "\\brecord\\s+drawings?\\b", "\\bproject\\s+record\\s+documents?\\b"]},
    {"item": "Operation and maintenance manuals", "patterns": ["\\boperation\\s+(?:and|&)\\s+maintenance\\s+(?:manuals?|data)\\b", "\\bO\\s*&\\s*M\\s+(?:manuals?|data)\\b"]},
    {"item": "Shop drawings and submittals", "patterns": ["\\bshop\\s+drawings?\\b", "\\bsubmittals?\\b"]},
    {"item": "Coordination drawings or 3-D building models", "patterns": ["\\bcoordination\\s+drawings?\\b", "(?-i:\\bBIM\\b)", "\\bRevit\\b", "\\bNavisworks\\b", "\\bclash\\s+detection\\b"]},
    {"item": "Spare parts, attic stock or extra materials", "patterns": ["\\bspare\\s+parts?\\b", "\\battic\\s+stock\\b", "\\bextra\\s+materials?\\b", "\\bspares\\b", "\\bmaintenance\\s+materials?\\b"]},
    {"item": "Software licences", "patterns": ["\\bsoftware\\s+licen[cs]\\w*\\b", "\\blicen[cs]es\\b", "\\blicensing\\b"]},
    {"item": "3-D graphics", "patterns": ["\\b3-?D\\s+graphics?\\b", "\\bthree[- ]dimensional\\s+graphics?\\b", "\\bgraphics?\\b[^.;]{0,40}\\b(?:3-?D|three[- ]dimensional)\\b"]},
    {"item": "Seasonal testing", "patterns": ["\\bseasonal\\s+(?:testing|commissioning|performance|tests?)\\b", "\\bopposite\\s+season\\b", "\\bdeferred\\s+(?:testing|tests?|commissioning)\\b"]},
    {"item": "Demonstration to the owner", "patterns": ["\\bdemonstrat\\w*\\b[^.;]{0,60}\\bowner\\b", "\\bowner(?:'s|’s)?\\b[^.;]{0,60}\\bdemonstrat\\w*", "\\bdemonstration\\b"]}
  ],

  "special_systems": [
    {"item": "Smoke control", "patterns": ["\\bsmoke\\s+control\\b", "\\bUUKL\\b", "\\bfire\\s*fighters?(?:'|’)?s?\\s+smoke\\s+control\\s+(?:stations?|panels?)\\b"]},
    {"item": "Laboratory or room pressure control", "patterns": ["\\broom\\s+pressur\\w*\\b", "\\b(?:room|space|differential|isolation)\\s+pressure\\s+monitors?\\b", "\\bfume\\s+hoods?\\b", "\\blab(?:oratory)?\\s+(?:air\\s*flow\\s+)?controls?\\b"]},
    {"item": "Isolation rooms", "patterns": ["\\b(?:airborne\\s+infection\\s+)?isolation\\s+rooms?\\b", "\\bprotective\\s+environment\\s+rooms?\\b", "\\bnegative\\s+pressure\\s+rooms?\\b"]},
    {"item": "Cybersecurity", "patterns": ["\\bcyber\\s*-?\\s*security\\b", "\\bIEC\\s*62443\\b", "\\bUL\\s*2900\\b", "\\bNIST\\s+(?:SP\\s+)?800\\b"]},
    {"item": "Panels built to UL 508A", "patterns": ["\\bUL[- ]?508A?\\b", "\\bUL[- ]listed\\s+(?:control\\s+)?panels?\\b"]},
    {"item": "Redundant controllers or a ring network", "patterns": ["\\bredundan\\w*\\b", "\\bring\\s+(?:network|topology)\\b", "\\bdevice\\s+level\\s+ring\\b", "\\bhot[- ]standby\\b", "\\bfail[- ]?over\\b"]},
    {"item": "SCADA (supervisory control and data acquisition)", "patterns": ["\\bSCADA\\b", "\\bsupervisory\\s+control\\s+and\\s+data\\s+acquisition\\b"]},
    {"item": "Hazardous locations or explosion-proof devices", "patterns": ["\\bhazardous\\s+(?:\\(classified\\)\\s+)?locations?\\b", "\\bclassified\\s+(?:locations?|areas?)\\b", "\\bclass\\s+I,?\\s+div(?:ision)?\\.?\\s*[12]\\b", "\\bexplosion[- ]?proof\\b", "\\bintrinsically\\s+safe\\b"]},
    {"item": "NEMA 4X enclosures", "patterns": ["\\bNEMA\\s*(?:type\\s*)?4X\\b"]},
    {"item": "Seismic requirements", "patterns": ["\\bseismic\\b"]}
  ],

  "conditions": [
    {"item": "Working hours: off-hours, night or weekend work", "patterns": ["\\b(?:normal|regular)\\s+(?:business\\s+)?(?:working\\s+)?hours\\b", "\\boff[- ]hours?\\b", "\\bafter[- ]hours\\b", "\\bovertime\\b", "\\b(?:night|weekend|evening)s?\\s+(?:work|shifts?|hours)\\b", "\\bnights?\\s+(?:and|or)\\s+weekends?\\b", "\\bpremium\\s+time\\b", "\\bwork(?:ing)?\\s+hours\\b"]},
    {"item": "Phased work", "patterns": ["\\bphasing\\b", "\\bphased\\s+(?:construction|work|occupancy|turnover|completion)\\b", "\\bconstruction\\s+(?:phases|sequencing)\\b", "\\bin\\s+(?:multiple\\s+)?phases\\b"]},
    {"item": "Occupied building", "patterns": ["\\boccupied\\s+(?:building|facility|spaces?|areas?|premises)\\b", "\\b(?:building|facility)\\s+(?:will|shall)\\s+(?:remain|be)\\s+(?:occupied|in\\s+operation)\\b"]},
    {"item": "Union labor", "patterns": ["\\bunion\\s+(?:labor|labour|workers?|contractors?|trades?|jurisdiction|agreements?)\\b", "\\bproject\\s+labor\\s+agreements?\\b", "\\bcollective\\s+bargaining\\b", "\\bunionized\\b"]},
    {"item": "Prevailing wage", "patterns": ["\\bprevailing\\s+wages?\\b", "\\bDavis[- ]Bacon\\b", "\\bcertified\\s+payrolls?\\b", "\\bwage\\s+(?:rates?|determinations?)\\b"]},
    {"item": "Security badging, background checks or escorts", "patterns": ["\\bbadg(?:e|es|ing|ed)\\b", "\\bbackground\\s+(?:checks?|screening|investigations?)\\b", "\\bescort(?:s|ed)?\\b", "\\bsecurity\\s+clearances?\\b", "\\bdrug\\s+(?:testing|screening)\\b"]},
    {"item": "Bonds", "patterns": ["\\b(?:bid|performance|payment|maintenance|surety|labor\\s+and\\s+material)\\s+bonds?\\b", "\\bsurety\\b"]},
    {"item": "Allowances", "patterns": ["\\ballowances?\\b"]},
    {"item": "Alternates", "patterns": ["\\b(?:add|deduct|bid)\\s+alternates?\\b", "\\balternates\\b", "\\balternate\\s+(?:no\\.?|#|number)?\\s*\\d+\\b"]},
    {"item": "Unit prices", "patterns": ["\\bunit\\s+prices?\\b"]},
    {"item": "Liquidated damages", "patterns": ["\\bliquidated\\s+damages\\b"]},
    {"item": "Tax exemption", "patterns": ["\\btax[- ]exempt\\w*\\b", "\\bexempt\\s+from\\s+(?:sales\\s+)?tax\\w*\\b", "\\bexemption\\s+certificates?\\b", "\\bsales\\s+tax\\b"]},
    {"item": "Minority or women-owned business participation", "patterns": ["\\b(?:minority|women)[- ]owned\\b", "(?-i:\\bM/?W?BE\\b)", "(?-i:\\bWBE\\b)", "(?-i:\\bDBE\\b)", "(?-i:\\bSDVOB\\b)", "\\bdisadvantaged\\s+business\\b", "\\bsmall\\s+business\\s+(?:participation|goals?)\\b"]}
  ]
}

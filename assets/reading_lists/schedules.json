{
  "about": "How equipment schedules are read off the drawing sheets (build step 4). Header words are compared after squashing spaces, ignoring case and a trailing full stop or colon. Patterns are regular expressions, matched ignoring case. Extend this file, never the code.",
  "tag_headers": ["UNIT NO", "UNIT NUMBER", "UNIT TAG", "UNIT MARK", "UNIT DESIGNATION", "TAG", "TAG NO", "EQUIPMENT TAG",
                  "EQUIP TAG", "EQUIPMENT NO", "MARK", "MARK NO", "DESIGNATION", "SYMBOL NO"],
  "type_headers": ["TYPE", "UNIT TYPE", "BOX TYPE", "FIXTURE TYPE", "DIFFUSER TYPE"],
  "manufacturer_headers": ["MANUFACTURER", "MANUFACTURERS", "MFR", "MFG", "MAKE", "BASIS OF DESIGN"],
  "model_headers": ["MODEL", "MODEL NO", "MODEL NUMBER", "MFR MODEL", "MODEL #"],
  "serves_headers": ["SERVES", "SERVICE", "SERVING", "AREA SERVED", "AREA SERVING", "SERVICE/LOCATION", "LOCATION"],
  "notes_headers": ["REMARKS", "NOTES", "NOTE", "COMMENTS", "REMARK"],
  "basis_of_design": ["MFR\\.?\\s*\\(AS STD\\.?\\)\\s*:?\\s*(.+)", "BASIS OF DESIGN\\s*:?\\s*(.+)"],
  "existing_words": ["\\bEXISTING\\b", "\\bEXIST\\.", "\\(E\\)", "\\bTO REMAIN\\b", "\\bTO BE REMOVED\\b"],
  "controls_phrases": ["TEMPERATURE CONTROLS? CONTRACTOR", "CONTROLS? CONTRACTOR", "\\bATC\\b", "\\bBMS\\b", "\\bBAS\\b",
                       "\\bDDC\\b", "\\bTCC\\b", "DIGITAL CONTROLS?", "FACTORY[- ](?:MOUNTED |INSTALLED |WIRED )?CONTROLS?",
                       "CONTROLS? PACKAGE", "UNIT CONTROLLER", "CONTROLS? VENDOR", "CONTROLS? BY", "\\bBACNET\\b",
                       "CONTROLLER"],
  "range_words": ["THRU", "THROUGH"],
  "notes_heading": "^\\s*(?:GENERAL\\s+)?NOTES?\\s*:?",
  "note_number": "^\\s*(?:\\(?\\d{1,2}[.)]|\\*)",
  "schedule_sheet_text": "\\bSCHEDULES?\\b",
  "border_share": 0.6,
  "min_rows": 2,
  "min_columns": 3,
  "notes_below": 200,
  "not_schedules": ["\\bCALCULATIONS?\\b"],
  "schedule_heading_about": "A line of a sheet's text that heads a schedule (\"EXHAUST FAN SCHEDULE\", \"ROOFTOP UNIT SCHEDULE (1 OF 2)\"). When a schedule sheet's tables can't be read (a picture read by OCR), its units are counted from its text, each under the nearest heading above it.",
  "schedule_heading": "^(?!(?:SEE|REFER|PER|AS)\\b)[A-Z][A-Z0-9 ,&/()'.+\\-]{1,80}?\\bSCHEDULES?\\b(?:\\s*\\([^)]*\\))?(?:\\s*-\\s*[A-Z ]{2,30})?$",
  "type_list_titles_about": "A schedule with one of these words in its title lists types of air device, silencer or fixture (passive items no controller serves), not units: a tag column whose prefix isn't in equipment.json is read as types there, never counted as units.",
  "type_list_titles": ["\\bGRILLES?\\b", "\\bREGISTERS?\\b", "\\bDIFFUSERS?\\b", "\\bLOUVERS?\\b", "\\bAIR (?:DEVICES?|OUTLETS?|INLETS?)\\b",
                       "\\bFIXTURES?\\b", "\\bDOORS?\\b", "\\bHARDWARE\\b", "\\bFINISH(?:ES)?\\b", "\\bLIGHT(?:ING)?\\b",
                       "\\bLUMINAIRES?\\b", "\\bSILENCERS?\\b", "\\bATTENUATORS?\\b"],
  "pairs":[["SS", "CU"], ["IU", "CU"], ["FCU", "CU"], ["CRAC", "ACCU"], ["AC", "CU"], ["HP", "ACCU"]]
}
